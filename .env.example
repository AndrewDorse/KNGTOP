# KNGTOP live deploy
# For a normal deploy, set only these two:
POLY_PRIVATE_KEY=0x...
POLY_FUNDER=0x...

# Current live entrypoint is S0184:
# - BTC 5m only
# - current BTC winner side only
# - first 20s only
# - ask in 0.46-0.56
# - BTC move from window open >= $1
# - buy size = max($1, 10% of available balance), checked once per new window
# - if held-side bid reaches 0.85+, send a FAK sell at 0.85
# Fallback size only if running dry or balance fetch fails:
KNGTOP_NOTIONAL_USD=1.0

# Live trading is the default when POLY_DRY_RUN is not set.
POLY_DRY_RUN=false

# Optional overrides
# KNGTOP_MARKET_BUY_MAX_PRICE=0.85
# KNGTOP_REQUEST_TIMEOUT_SECONDS=5.0
# KNGTOP_HEDGE_MAX_ORDERS_PER_SIDE=2
# KNGTOP_LOG_LEVEL=ERROR
