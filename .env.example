# KNGTOP live deploy
# For a normal deploy, set only these two:
POLY_PRIVATE_KEY=0x...
POLY_FUNDER=0x...

# Current live entrypoint:
# - BTC 5m two-sided limit-order engine
# - from 20s before window open, keep one 5-share buy order per side at 0.47
# - after fills, keep max one open buy order per side while below max shares
# - never keep two buy orders on the same side
# - cancel duplicate same-side orders
# - cancel/replace only to lower a worse existing buy price, never chase upward
# - target prices must improve side avg and keep projected avg sum <= 0.95
# - max $20 spent, max 15 PM-confirmed shares per side
KNGTOP_NOTIONAL_USD=2.0
KNGTOP_MAX_SHARES_PER_SIDE=15.0
KNGTOP_MAX_SHARE_GAP=2.0
KNGTOP_REPAIR_AVG_SUM_CAP=0.95
KNGTOP_LOCKED_PROFIT_ROI=0.10

# Live trading is the default when POLY_DRY_RUN is not set.
POLY_DRY_RUN=false

# Optional overrides
# KNGTOP_MARKET_BUY_MAX_PRICE=0.85
# KNGTOP_REQUEST_TIMEOUT_SECONDS=5.0
# KNGTOP_ORDER_RETRY_ON_ERROR=0
# KNGTOP_LOG_LEVEL=INFO
