# KNGTOP live deploy
POLY_PRIVATE_KEY=0x...
POLY_FUNDER=0x...

# Current live entrypoint:
# - BTC 5m Binance-spike paired resting-limit bot
# - live default variant: binance_looser_10usd_13x + immediate_repair_mkt
# - trigger-side buy at current ask
# - opposite-side buy at ask minus discount
# - pair avg sum must stay <= 0.95
# - 5-share base orders, 10-share boost on the smaller side when imbalance >= 5 shares
# - if imbalance exists, immediately post weak-side repair at current ask
# - 15 max filled shares per side
# - 15 USD max total exposure per window
# - 10s pair cooldown
# - 30s resting order expiry
# - no new buys after 220s, cancel all buys after 240s
POLY_DRY_RUN=false
KNGTOP_PAIRS=BTC:BTCUSDT
KNGTOP_MAX_SHARES_PER_SIDE=15.0
KNGTOP_REPAIR_AVG_SUM_CAP=0.95
KNGTOP_SPIKE_MOVE_LOOKBACK_SEC=5
KNGTOP_SPIKE_MOVE_THRESHOLD_USD=10.0
KNGTOP_SPIKE_VOLUME_LOOKBACK_SEC=20
KNGTOP_SPIKE_VOLUME_RATIO_MIN=1.3
KNGTOP_PAIR_COOLDOWN_SEC=10.0
KNGTOP_PAIR_ORDER_EXPIRY_SEC=30.0
KNGTOP_OPPOSITE_SIDE_DISCOUNT=0.06

# Optional overrides
# KNGTOP_REQUEST_TIMEOUT_SECONDS=5.0
# KNGTOP_BINANCE_MAX_AGE_SEC=6.0
# KNGTOP_POLY_MID_MAX_AGE_SEC=5.0
# KNGTOP_WS_REST_POLL_ENABLE=true
# KNGTOP_WS_REST_POLL_INTERVAL_SECONDS=1.0
# KNGTOP_LOG_LEVEL=INFO
