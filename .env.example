# =============================================================================
# KNGTOP — Polymarket BTC / ETH / XRP / SOL Up/Down 5m + 15m misprice runner (FAK buys)
# =============================================================================
POLY_PRIVATE_KEY=0x...
POLY_FUNDER=0x...
POLY_SIGNATURE_TYPE=1
RELAYER_API_KEY=
RELAYER_SECRET=
RELAYER_PASSPHRASE=

# true = signals only (no CLOB post); false = live FAK buys
POLY_DRY_RUN=true

# Market buy USDC amount (CLOB ``amount``) — always $1 for BTC/ETH/XRP
KNGTOP_NOTIONAL_USD=1.0

# Comma list: GAMMA asset key : Binance USDT symbol (only BTC, ETH, XRP, SOL supported)
KNGTOP_PAIRS=BTC:BTCUSDT,ETH:ETHUSDT,XRP:XRPUSDT,SOL:SOLUSDT

# Heartbeat when feeds are quiet + minimum eval period (seconds)
KNGTOP_POLL_INTERVAL_SECONDS=0.2
# Coalesce bursty WS callbacks before one eval pass (seconds)
KNGTOP_EVAL_DEBOUNCE_SECONDS=0.025

# Per-share buy ceiling for market FAK (default 0.33); clamped to 1 - tick for the token
KNGTOP_MARKET_BUY_MAX_PRICE=0.33
KNGTOP_REQUEST_TIMEOUT_SECONDS=12.0

# Stale guards (cached last trade / last PM mid)
KNGTOP_BINANCE_MAX_AGE_SEC=6.0
KNGTOP_POLY_MID_MAX_AGE_SEC=5.0

# When a symbol/token is stale vs the guards above, refresh via public REST (1/s loop; disable to use WS only)
KNGTOP_WS_REST_POLL_ENABLE=true
# Clamped to [0.2, 120] seconds
KNGTOP_WS_REST_POLL_INTERVAL_SECONDS=1.0

# Library log level; stdout events: single INIT at boot, DEAL_START(with start/spot/PM trigger prices), DEAL_FAIL, ERROR
KNGTOP_LOG_LEVEL=ERROR
# Extra attempts after a failed market post (2 => 3 tries total)
KNGTOP_ORDER_RETRY_ON_ERROR=2

# Skip new entries when this many seconds remain in the window
KNGTOP_ORDER_CUTOFF_REMAINING_SEC=20
