# KNGTOP live deploy
# For a normal deploy, set only these two:
POLY_PRIVATE_KEY=0x...
POLY_FUNDER=0x...

# Current live entrypoint:
# - BTC 5m guarded PnL-balance candidate C
# - first lower-ask buy <= 0.55 for $2
# - then buy only the weaker outcome side
# - cheap weak repair <= 0.45
# - guarded high repair <= 0.60
# - pre-240s hard high cap 0.65
# - final 60s danger cap 0.80
# - max $20 spent, 15 filled buys total, 8 filled buys per side
KNGTOP_NOTIONAL_USD=2.0

# Live trading is the default when POLY_DRY_RUN is not set.
POLY_DRY_RUN=false

# Optional overrides
# KNGTOP_MARKET_BUY_MAX_PRICE=0.90
# KNGTOP_REQUEST_TIMEOUT_SECONDS=5.0
# KNGTOP_ORDER_RETRY_ON_ERROR=0
# KNGTOP_LOG_LEVEL=INFO
