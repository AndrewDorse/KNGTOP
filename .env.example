# =============================================================================
# KNGTOP — Polymarket BTC 5m + 15m misprice runner ($1 py_clob_client_v2 market buys)
# =============================================================================
POLY_PRIVATE_KEY=0x...
POLY_FUNDER=0x...
POLY_SIGNATURE_TYPE=1
RELAYER_API_KEY=
RELAYER_SECRET=
RELAYER_PASSPHRASE=

# true = log signals only; false = post FAK market buys
POLY_DRY_RUN=true

# $1 notional per signal (CLOB market order amount in USDC)
KNGTOP_NOTIONAL_USD=1.0

KNGTOP_POLL_INTERVAL_SECONDS=0.35
KNGTOP_REQUEST_TIMEOUT_SECONDS=12.0
KNGTOP_BTC_FEED_SYMBOL=BTCUSDT
KNGTOP_MARKET_SYMBOL=BTC
KNGTOP_LOG_LEVEL=INFO

# Skip new entries when this many seconds remain in the window
KNGTOP_ORDER_CUTOFF_REMAINING_SEC=20
